<?xml version="1.0" encoding="utf-8"?>
<!--
    Copia de seguridad automática (Android 11 y anteriores). La sesión cifrada no se respalda:
    su clave vive en Android Keystore y no viaja con la copia (HU003 CA6). Tampoco los registros
    de entrenamiento y su cola de sincronización (HU032, ADR-029 offline §5) ni la caché
    del calendario deportivo (HU035, ADR-031 offline §3), ni la cola cifrada de revocación
    de sesión (HU004, ADR-026) ni los indicadores de HU034 (ADR-030 offline §1).
-->
<full-backup-content>
    <exclude domain="sharedpref" path="sportapp_secure_session.xml" />
    <exclude domain="database" path="sportapp_training.db" />
    <exclude domain="database" path="sportapp_training.db-shm" />
    <exclude domain="database" path="sportapp_training.db-wal" />
    <exclude domain="database" path="sportapp_training.db-journal" />
    <exclude domain="database" path="sportapp_calendar.db" />
    <exclude domain="database" path="sportapp_calendar.db-shm" />
    <exclude domain="database" path="sportapp_calendar.db-wal" />
    <exclude domain="database" path="sportapp_calendar.db-journal" />
    <exclude domain="database" path="sportapp_revocation.db" />
    <exclude domain="database" path="sportapp_revocation.db-shm" />
    <exclude domain="database" path="sportapp_revocation.db-wal" />
    <exclude domain="database" path="sportapp_revocation.db-journal" />
    <exclude domain="database" path="sportapp_training_metrics.db" />
    <exclude domain="database" path="sportapp_training_metrics.db-shm" />
    <exclude domain="database" path="sportapp_training_metrics.db-wal" />
    <exclude domain="database" path="sportapp_training_metrics.db-journal" />
</full-backup-content>
