<?xml version="1.0" encoding="utf-8"?>
<!--
    Copia de seguridad automática (Android 11 y anteriores). La sesión cifrada no se respalda:
    su clave vive en Android Keystore y no viaja con la copia (HU003 CA6). Tampoco los registros
    de entrenamiento y su cola de sincronización (HU032, ADR-029 offline §5).
-->
<full-backup-content>
    <exclude domain="sharedpref" path="sportapp_secure_session.xml" />
    <exclude domain="database" path="sportapp_training.db" />
    <exclude domain="database" path="sportapp_training.db-shm" />
    <exclude domain="database" path="sportapp_training.db-wal" />
    <exclude domain="database" path="sportapp_training.db-journal" />
</full-backup-content>
