<?xml version="1.0" encoding="utf-8"?>
<!--
    Copia en la nube y transferencia entre dispositivos (Android 12+). La sesión cifrada (HU003 CA6),
    los registros de entrenamiento con su cola de sincronización (HU032, ADR-029 offline §5), la
    caché del calendario deportivo (HU035, ADR-031 offline §3) y la cola cifrada de revocación de
    sesión (HU004, ADR-026), los indicadores de HU034 (ADR-030), la caché de entrenamientos sugeridos
    (HU028, ADR-041 §5), la del tablero de entrenamientos (HU033, ADR-043 §5) y la de rutas sugeridas
    (HU026, ADR-041 §5) y la de sesiones virtuales (HU040, ADR-046 §8) se excluyen de ambas.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="sportapp_secure_session.xml" />
        <exclude domain="database" path="sportapp_training.db" />
        <exclude domain="database" path="sportapp_training.db-shm" />
        <exclude domain="database" path="sportapp_training.db-wal" />
        <exclude domain="database" path="sportapp_training.db-journal" />
        <exclude domain="database" path="sportapp_calendar.db" />
        <exclude domain="database" path="sportapp_calendar.db-shm" />
        <exclude domain="database" path="sportapp_calendar.db-wal" />
        <exclude domain="database" path="sportapp_calendar.db-journal" />
        <exclude domain="database" path="sportapp_revocation.db" />
        <exclude domain="database" path="sportapp_revocation.db-shm" />
        <exclude domain="database" path="sportapp_revocation.db-wal" />
        <exclude domain="database" path="sportapp_revocation.db-journal" />
        <exclude domain="database" path="sportapp_training_metrics.db" />
        <exclude domain="database" path="sportapp_training_metrics.db-shm" />
        <exclude domain="database" path="sportapp_training_metrics.db-wal" />
        <exclude domain="database" path="sportapp_training_metrics.db-journal" />
        <exclude domain="database" path="sportapp_plan_suggestions.db" />
        <exclude domain="database" path="sportapp_plan_suggestions.db-shm" />
        <exclude domain="database" path="sportapp_plan_suggestions.db-wal" />
        <exclude domain="database" path="sportapp_plan_suggestions.db-journal" />
        <exclude domain="database" path="sportapp_training_dashboard.db" />
        <exclude domain="database" path="sportapp_training_dashboard.db-shm" />
        <exclude domain="database" path="sportapp_training_dashboard.db-wal" />
        <exclude domain="database" path="sportapp_training_dashboard.db-journal" />
        <exclude domain="database" path="sportapp_route_suggestions.db" />
        <exclude domain="database" path="sportapp_route_suggestions.db-shm" />
        <exclude domain="database" path="sportapp_route_suggestions.db-wal" />
        <exclude domain="database" path="sportapp_route_suggestions.db-journal" />
        <exclude domain="database" path="sportapp_virtual_sessions.db" />
        <exclude domain="database" path="sportapp_virtual_sessions.db-shm" />
        <exclude domain="database" path="sportapp_virtual_sessions.db-wal" />
        <exclude domain="database" path="sportapp_virtual_sessions.db-journal" />
        <exclude domain="database" path="sportapp_event_registrations.db" />
        <exclude domain="database" path="sportapp_event_registrations.db-shm" />
        <exclude domain="database" path="sportapp_event_registrations.db-wal" />
        <exclude domain="database" path="sportapp_event_registrations.db-journal" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="sportapp_secure_session.xml" />
        <exclude domain="database" path="sportapp_training.db" />
        <exclude domain="database" path="sportapp_training.db-shm" />
        <exclude domain="database" path="sportapp_training.db-wal" />
        <exclude domain="database" path="sportapp_training.db-journal" />
        <exclude domain="database" path="sportapp_calendar.db" />
        <exclude domain="database" path="sportapp_calendar.db-shm" />
        <exclude domain="database" path="sportapp_calendar.db-wal" />
        <exclude domain="database" path="sportapp_calendar.db-journal" />
        <exclude domain="database" path="sportapp_revocation.db" />
        <exclude domain="database" path="sportapp_revocation.db-shm" />
        <exclude domain="database" path="sportapp_revocation.db-wal" />
        <exclude domain="database" path="sportapp_revocation.db-journal" />
        <exclude domain="database" path="sportapp_training_metrics.db" />
        <exclude domain="database" path="sportapp_training_metrics.db-shm" />
        <exclude domain="database" path="sportapp_training_metrics.db-wal" />
        <exclude domain="database" path="sportapp_training_metrics.db-journal" />
        <exclude domain="database" path="sportapp_plan_suggestions.db" />
        <exclude domain="database" path="sportapp_plan_suggestions.db-shm" />
        <exclude domain="database" path="sportapp_plan_suggestions.db-wal" />
        <exclude domain="database" path="sportapp_plan_suggestions.db-journal" />
        <exclude domain="database" path="sportapp_training_dashboard.db" />
        <exclude domain="database" path="sportapp_training_dashboard.db-shm" />
        <exclude domain="database" path="sportapp_training_dashboard.db-wal" />
        <exclude domain="database" path="sportapp_training_dashboard.db-journal" />
        <exclude domain="database" path="sportapp_route_suggestions.db" />
        <exclude domain="database" path="sportapp_route_suggestions.db-shm" />
        <exclude domain="database" path="sportapp_route_suggestions.db-wal" />
        <exclude domain="database" path="sportapp_route_suggestions.db-journal" />
        <exclude domain="database" path="sportapp_virtual_sessions.db" />
        <exclude domain="database" path="sportapp_virtual_sessions.db-shm" />
        <exclude domain="database" path="sportapp_virtual_sessions.db-wal" />
        <exclude domain="database" path="sportapp_virtual_sessions.db-journal" />
        <exclude domain="database" path="sportapp_event_registrations.db" />
        <exclude domain="database" path="sportapp_event_registrations.db-shm" />
        <exclude domain="database" path="sportapp_event_registrations.db-wal" />
        <exclude domain="database" path="sportapp_event_registrations.db-journal" />
    </device-transfer>
</data-extraction-rules>
