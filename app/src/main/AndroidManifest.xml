<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- HU039: notificaciones del sistema de la bandeja de eventos; se solicita en tiempo de ejecución (Android 13+). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- HU038: servicio en primer plano de la sesión de entrenamiento en curso (tipo specialUse, ADR-045 §6). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!--
        HU037: monitor de frecuencia cardiaca Bluetooth LE (ADR-044 §2). Android 12+: buscar sin derivar
        ubicación y conectar; se solicitan en tiempo de ejecución al buscar. Android 9–11 no se admite
        mientras no se definan sus permisos (sin ubicación).
    -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="31" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />

    <application
        android:name=".SportApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Sportapp"
        tools:targetApi="31">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Sportapp"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            HU038: sesión de entrenamiento en curso (HU032) con su notificación persistente y el motor local
            de recordatorios; HU037 añade la lectura del monitor de frecuencia cardiaca BLE; reutilizable por
            HU036. specialUse: el tipo health exigiría permisos de sensores fuera del alcance. Una publicación
            en Google Play exigiría justificarlo en la consola.
        -->
        <service
            android:name=".features.training.session.foreground.ActiveSessionService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Cronómetro de la sesión de entrenamiento iniciada por el deportista, recordatorios locales de hidratación y alimentación y, si vinculó un monitor de frecuencia cardiaca Bluetooth, lectura y envío de su frecuencia cardiaca mientras dura la sesión." />
        </service>

        <!-- WorkManager se inicializa bajo demanda con la fábrica de SportApp (HU032). -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>

</manifest>
